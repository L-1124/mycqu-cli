[
  {
    "path": "auth login",
    "description": "登录统一身份认证账号；需要人工输入时返回 challenge_id 供续接",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "--auth"
      ],
      "properties": {
        "--auth": {
          "type": "string",
          "minLength": 1,
          "description": "统一身份认证账号（学工号或学号）"
        },
        "--stdin-password": {
          "type": "boolean",
          "default": false,
          "description": "从标准输入读取密码"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": [
        "schema_version",
        "ok",
        "meta"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "description": "输出契约版本"
        },
        "ok": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "message": {
              "type": "string"
            },
            "cleanup": {
              "type": "object",
              "description": "本地清理结果；challenge_cleared 为 false 时流程可能未彻底结束",
              "properties": {
                "session_persisted": {
                  "type": "boolean",
                  "description": "会话终态是否已写入本地"
                },
                "challenge_cleared": {
                  "type": "boolean",
                  "description": "本地挑战状态是否已清理"
                },
                "captcha_cleared": {
                  "type": "boolean",
                  "description": "验证码图片是否已清理"
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "challenge_id": {
              "type": "string",
              "description": "不透明挑战 ID；auth verify 必须回传匹配值"
            },
            "next_action": {
              "type": "string"
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "complete",
            "timezone"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "timezone": {
              "type": "string",
              "const": "Asia/Shanghai"
            },
            "count": {
              "type": "integer"
            },
            "stop_reason": {
              "type": "string"
            },
            "checked_service": {
              "type": "string"
            },
            "checked_at": {
              "type": "string"
            }
          }
        }
      }
    },
    "requires_auth": false,
    "has_side_effects": true,
    "confirmation": {
      "required": true,
      "reason": "使用用户提供的账号密码发起真实登录",
      "user_authorization": "调用环境需已获得用户授权；密码只接受隐藏终端输入或 stdin"
    },
    "next_actions": {
      "CAPTCHA_REQUIRED": "auth captcha",
      "SECOND_FACTOR_REQUIRED": "auth send-code",
      "INVALID_CREDENTIALS": "auth verify"
    },
    "possible_errors": [
      "INVALID_ARGUMENT",
      "AUTH_REQUIRED",
      "INVALID_CREDENTIALS",
      "CAPTCHA_REQUIRED",
      "SECOND_FACTOR_REQUIRED",
      "AUTH_FLOW_EXPIRED",
      "NETWORK_TIMEOUT",
      "UPSTREAM_ERROR"
    ]
  },

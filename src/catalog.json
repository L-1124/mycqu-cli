        },
        "--stdin-code": {
          "type": "boolean",
          "default": false,
          "description": "从标准输入读取验证码内容"
        },
        "--kind": {
          "type": "string",
          "enum": [
            "sms",
            "mail"
          ],
          "default": "sms",
          "description": "二次验证通道类型"
        },
        "--stdin-password": {
          "type": "boolean",
          "default": false,
          "description": "通过 stdin 输入密码（图形验证码重试）"
        }
      }
    },

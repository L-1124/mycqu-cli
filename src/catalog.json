            "message": {
              "type": "string"
            },
            "cleanup": {
              "type": "object",
              "description": "本地清理结果；challenge_cleared 为 false 时流程可能未彻底结束",
              "properties": {
                "session_persisted": {
                  "type": "boolean",
                  "description": "会话终态是否已写入本地"
                },
                "challenge_cleared": {
                  "type": "boolean",
                  "description": "本地挑战状态是否已清理"
                },
                "captcha_cleared": {
                  "type": "boolean",
                  "description": "验证码图片是否已清理"
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "challenge_id": {
              "type": "string",
              "description": "轮换后的新挑战 ID；后续 auth verify 必须回传"
            },
            "next_action": {
              "type": "string"
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "complete",
            "timezone"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "timezone": {
              "type": "string",
              "const": "Asia/Shanghai"
            }
          }
        }
      }
    },
    "requires_auth": false,
    "has_side_effects": true,
    "confirmation": {
      "required": true,
      "reason": "提交用户提供的验证码，继续真实认证流程",
      "user_authorization": "需符合调用环境的用户授权与确认要求"
    },

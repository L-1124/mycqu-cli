              ]
            }
          }
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "complete",
            "timezone"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "timezone": {
              "type": "string",
              "const": "Asia/Shanghai"
            },
            "checked_service": {
              "type": "string"
            },
            "checked_at": {
              "type": "string"
            }
          }
        }
      }
    },
    "requires_auth": false,
    "has_side_effects": false,
    "next_actions": {
      "AUTH_REQUIRED": "auth login"
    },
    "possible_errors": [
      "AUTH_REQUIRED",
      "STATE_INVALID",
      "NETWORK_TIMEOUT",
      "UPSTREAM_ERROR"
    ]
  },
